# ── Database ──────────────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → URI (copy Connection string → URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Run this to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# github.com/settings/developers → OAuth Apps → New OAuth App
# Homepage URL:  http://localhost:3000
# Callback URL:  http://localhost:5000/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email — Resend (DAY 12) ───────────────────────────────────────────────────
# Sign up free at resend.com → API Keys → Create Key
# In development leave blank — emails are logged to console instead
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=ShipLog <noreply@shiplog.io>

# ── Stripe (DAY 13) ───────────────────────────────────────────────────────────
# stripe.com → Dashboard → Developers → API Keys
# Use TEST keys during development (start with sk_test_)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# stripe.com → Dashboard → Webhooks → Add endpoint → copy signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# stripe.com → Products → Create product → copy price IDs
STRIPE_PRO_PRICE_ID=price_pro_id_here
STRIPE_TEAM_PRICE_ID=price_team_id_here
